# Copiá este archivo a backend/.env y completá con los valores reales
# de tu proyecto Supabase (nunca commitees backend/.env).

# Settings -> Database -> Connection string -> Session pooler (puerto 5432).
# Preferí el Session pooler sobre el Transaction pooler (6543): SQLAlchemy
# usa un pool de conexiones persistentes con prepared statements, que el
# Transaction pooler no soporta de forma confiable.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Settings -> API
# SUPABASE_URL es obligatoria: el backend arma con ella la URL del JWKS
# público (.well-known/jwks.json) para validar los tokens de Supabase
# Auth, así que funciona tanto con proyectos nuevos (claves ES256) como
# viejos (secreto HS256 legacy) sin configuración extra.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Reservada para uso administrativo futuro (ej. subidas server-side a
# Storage). Nunca exponer esta key al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
